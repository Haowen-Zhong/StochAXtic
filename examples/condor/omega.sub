# omega.sub -- Omega_GW(f) for several populations, one job each
# (~10-20 s on one core for 8 replicas x 2^12 points).
#
# Each queue line sets: tag, mass_model, rate_model, R0 (Gpc^-3 yr^-1).
# The package directory is transferred with the job; the result
# $(tag).npz comes back to initialdir = $(OUT_DIR), which must exist.

PKG_DIR = /home/haowen.zhong/StochAXtic
OUT_DIR = /home/haowen.zhong/StochAXtic/results
LOG_DIR = /home/haowen.zhong/StochAXtic/logs

universe        = container
container_image = /home/haowen.zhong/Var_Omega_theory/vegas_int/MOGWAS/MOGWAS.sif

executable = $(PKG_DIR)/examples/condor/run_omega.sh
arguments  = "run $(tag).npz --mass-model $(mass_model) --rate-model $(rate_model) --R0 $(R0) --waveform IMRPhenomXAS --n-rep 8 --log2-points 12"

initialdir = $(OUT_DIR)

MY.POOLS              = "CIT"
notification          = error
accounting_group      = ligo.sim.o4.sgwb.explore.test
accounting_group_user = haowen.zhong

request_cpus  = 1
RequestMemory = 2GB
RequestDisk   = 200MB

log    = $(LOG_DIR)/omega_$(tag).log
output = $(LOG_DIR)/omega_$(tag).out
error  = $(LOG_DIR)/omega_$(tag).err

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# no trailing slash: the directory itself is transferred
transfer_input_files    = $(PKG_DIR)/stochaxtic

queue tag, mass_model, rate_model, R0 from (
    BBH_md,  bpl_double_gaussian, madau_dickinson,           15.9
    BNS_td,  uniform,             madau_dickinson_timedelay, 23.4
    NSBH_td, nsbh_modsmooth,      madau_dickinson_timedelay, 15.9
)
